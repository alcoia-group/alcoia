{
  "name": "alcoia-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "alcoia browser extension \u2014 tests and tooling. The extension itself lives in alcoia/ and ships unbundled.",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tests/browser/smoke.mjs",
    "questions:review": "node tools/question-quality.mjs",
    "build": "node build.mjs",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "vitest": "^3.2.4"
  }
}
